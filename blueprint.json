{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "המרכז לתולדות הטבע במורשת ישראל – תצוגה",
    "description": "תצוגה של ערכת העיצוב החדשה עם תוכן לדוגמה. האתר נבנה מחדש בכל פתיחה.",
    "author": "AmarShaked"
  },
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "features": { "networking": true },
  "login": true,
  "steps": [
    { "step": "setSiteLanguage", "language": "he_IL" },
    { "step": "mkdir", "path": "/wordpress/wp-content/mu-plugins" },
    { "step": "writeFile", "path": "/wordpress/wp-content/mu-plugins/cc-preview-mu.php", "data": { "resource": "url", "url": "https://raw.githubusercontent.com/AmarShaked/center-site-demo/main/cc-preview-mu.php" } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "polylang" } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "contact-form-7" } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://raw.githubusercontent.com/AmarShaked/center-site-demo/main/center-core.zip" } },
    { "step": "installTheme", "themeData": { "resource": "url", "url": "https://raw.githubusercontent.com/AmarShaked/center-site-demo/main/center-theme.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://raw.githubusercontent.com/AmarShaked/center-site-demo/main/center-demo.zip" } },
    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; wp_set_current_user( 1 ); require ABSPATH . 'wp-admin/includes/admin.php'; if ( function_exists( 'cc_demo_finish' ) ) { cc_demo_finish(); } delete_transient( 'pll_activation_redirect' );" }
  ]
}
